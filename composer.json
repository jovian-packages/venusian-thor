{
    "name": "jovian/venusian-thor",
    "description": "ThorVG rasterization and painting drivers for Venusian Topside, through ext-thorvg.",
    "version": "0.11.0",
    "type": "library",
    "keywords": [
        "framework",
        "venusian",
        "topside",
        "rasterization",
        "rasterizer",
        "painting",
        "thorvg"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-thor/0.11.x",
    "support": {
        "issues": "https://github.com/jovian-packages/venusian-thor/issues",
        "source": "https://github.com/jovian-packages/venusian-thor"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "ext-thorvg": "^0.11.0",
        "venusian/topside": "^0.11.5"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Rendering\\Thor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jovian\\Rendering\\Thor\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Rendering\\Thor\\Providers\\VenusianThorServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
